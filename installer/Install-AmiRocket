.key DEST/A,PREFS,CONFIG,DATA
.def PREFS "SYS:Prefs"
.def DATA "SYS:AmiRocket"
.bra {
.ket }
; Application files go into DEST; the Preferences executable goes into PREFS.
FailAt 10
"CreateIcons" CHECK
If WARN
 Echo "Close AmiRocket before installation."
 Quit 10
EndIf
FailAt 5
If NOT EXISTS "{DEST}"
 MakeDir "{DEST}"
EndIf
If NOT EXISTS "{PREFS}"
 MakeDir "{PREFS}"
EndIf
If NOT EXISTS "{DATA}"
 MakeDir "{DATA}"
EndIf
"CreateIcons" "{DATA}" DATA-CHECK "{DEST}" "{PREFS}"
If NOT EXISTS "{DATA}/Plugins"
 MakeDir "{DATA}/Plugins"
EndIf
If NOT EXISTS "{DATA}/Rexx"
 MakeDir "{DATA}/Rexx"
EndIf
If NOT EXISTS "{DATA}/Sounds"
 MakeDir "{DATA}/Sounds"
EndIf
If NOT EXISTS "{DATA}/licenses"
 MakeDir "{DATA}/licenses"
EndIf
If NOT EXISTS "{PREFS}/AmiRocketPrefs.info"
 If EXISTS "{DEST}/AmiRocketPrefs.info"
  Copy "{DEST}/AmiRocketPrefs.info" TO "{PREFS}/AmiRocketPrefs.info" CLONE
 EndIf
EndIf
Copy "AmiRocket" TO "{DEST}/AmiRocket" CLONE
Copy "AmiRocket.guide" TO "HELP:AmiRocket.guide" CLONE
If NOT EXISTS "HELP:AmiRocket.guide.info"
 Copy "AmiRocket.guide.info" TO "HELP:AmiRocket.guide.info" CLONE
EndIf
If NOT EXISTS "{DEST}/AmiRocket.info"
 Copy "AmiRocket.info" TO "{DEST}/AmiRocket.info" CLONE
EndIf
Copy "AmiRocketMonitor" TO "{DATA}/AmiRocketMonitor" CLONE
Copy "AmiRocketPrefs" TO "{PREFS}/AmiRocketPrefs" CLONE
If NOT EXISTS "{PREFS}/AmiRocketPrefs.info"
 Copy "AmiRocketPrefs.info" TO "{PREFS}/AmiRocketPrefs.info" CLONE
EndIf
Copy "BUILD-PROVENANCE.json" TO "{DATA}/BUILD-PROVENANCE.json" CLONE
Copy "CHANGELOG.md" TO "{DATA}/CHANGELOG.md" CLONE
Copy "COPYRIGHT" TO "{DATA}/COPYRIGHT" CLONE
Copy "CreateIcons" TO "{DATA}/CreateIcons" CLONE
Copy "LICENSE" TO "{DATA}/LICENSE" CLONE
Copy "Plugins/quickreply.arp" TO "{DATA}/Plugins/quickreply.arp" CLONE
Copy "Plugins/quickreply.arp.meta" TO "{DATA}/Plugins/quickreply.arp.meta" CLONE
Copy "Plugins/timestamp.arp" TO "{DATA}/Plugins/timestamp.arp" CLONE
Copy "Plugins/timestamp.arp.meta" TO "{DATA}/Plugins/timestamp.arp.meta" CLONE
Copy "README.md" TO "{DATA}/README.md" CLONE
Copy "ReadMe" TO "{DATA}/ReadMe" CLONE
Copy "Rexx/connection.rexx" TO "{DATA}/Rexx/connection.rexx" CLONE
Copy "Rexx/dock-status.rexx" TO "{DATA}/Rexx/dock-status.rexx" CLONE
Copy "Rexx/low-memory.rexx" TO "{DATA}/Rexx/low-memory.rexx" CLONE
Copy "Rexx/novadock-toggle.rexx" TO "{DATA}/Rexx/novadock-toggle.rexx" CLONE
Copy "Rexx/quick-reply.rexx" TO "{DATA}/Rexx/quick-reply.rexx" CLONE
Copy "Rexx/status.rexx" TO "{DATA}/Rexx/status.rexx" CLONE
Copy "Sounds/Notification.8svx" TO "{DATA}/Sounds/Notification.8svx" CLONE
Copy "VERSION" TO "{DATA}/VERSION" CLONE
Copy "licenses/Beam68-release-tools.txt" TO "{DATA}/licenses/Beam68-release-tools.txt" CLONE
"CreateIcons" "{CONFIG}" CONFIG
"CreateIcons" "{DEST}" ICONS "{PREFS}"
"CreateIcons" "{DATA}" DATA "{DEST}" "{PREFS}"
"CreateIcons" "{DEST}" RECORD "{PREFS}"
If EXISTS "{DEST}/Install"
 Delete "{DEST}/Install"
EndIf
If EXISTS "{DEST}/Install.info"
 Delete "{DEST}/Install.info"
EndIf
If EXISTS "{DEST}/scripts/Install-AmiRocket"
 Delete "{DEST}/scripts/Install-AmiRocket"
EndIf
"CreateIcons" "{DEST}" CLEAN-LEGACY "{PREFS}"
Echo "AmiRocket installed. Settings preserved."
